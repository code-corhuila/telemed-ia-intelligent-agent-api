# Copy to .env and fill. .env is gitignored and must never be committed.

PORT=8086
MANAGEMENT_PORT=9086

# Tokens are signed by identity-api; the agent only needs its public key.
JWT_ISSUER=telemed-ia-identity-and-access
JWT_PUBLIC_KEY_HOST_FILE=/absolute/path/to/jwt-public.pem

# Pre-consultation limits and AI provider: scripted (no key) or groq.
AGENT_QUESTION_LIMIT=8
AGENT_MINIMUM_QUESTIONS=4
# Runbook mitigation 1: true refuses new pre-consultations (503 PRECONSULTATION_PAUSED).
AGENT_PRECONSULTATIONS_PAUSED=false
AGENT_MODEL_PROVIDER=scripted
# Only with AGENT_MODEL_PROVIDER=groq. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# agent-db as the least-privilege intelligent_agent_app user (infra-mongo provisions it).
MONGODB_URI=mongodb://intelligent_agent_app:<password>@mongo:27017/intelligent_agent?replicaSet=rs0&authSource=intelligent_agent

# appointment-scheduling-api; leave empty to keep pre-consultations closed.
APPOINTMENTS_BASE_URL=http://appointment-scheduling-api:8080
